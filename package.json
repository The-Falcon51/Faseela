{
  "name": "faseela-app",
  "version": "1.0.0",
  "description": "Faseela - Fractional Syrian Olive Tree Stewardship Mobile App for iOS & Android",
  "main": "public/index.html",
  "scripts": {
    "build:web": "node scripts/build-web.cjs",
    "sync": "node scripts/sync-web-assets.cjs",
    "sync:all": "node scripts/sync-web-assets.cjs --include-faseela",
    "build": "node --check functions/domain.js && node --check public/app.js && node --check public/i18n-de.js && node --check public/events.js && node --check public/shop.js && node --check public/assistant-knowledge.js && node --check public/supabase-client.mjs && node --check public/data-mappers.mjs && node --check public/admin/admin.mjs && node --check public/auth/reset.mjs && node scripts/version-assets.cjs --check && node scripts/sync-web-assets.cjs --check && node scripts/check-frontend.cjs && node scripts/check-claims.cjs",
    "test": "npm --prefix functions test",
    "test:web": "node --test tests/*.test.mjs",
    "test:all": "npm test && npm run test:web && npm run test:ui && npm run test:db && npm run test:e2e",
    "test:e2e": "node tests/e2e/run-e2e.cjs",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:android": "npx cap run android",
    "cap:run:ios": "npx cap run ios",
    "seed:sql": "node scripts/supabase-seed.cjs",
    "test:db": "node scripts/run-sql-tests.cjs",
    "db:local": "node scripts/local-db.cjs",
    "test:db:local": "node scripts/local-db.cjs --test",
    "test:ui": "node tests/e2e/handlers.e2e.mjs",
    "test:admin": "node tests/e2e/admin.e2e.mjs",
    "test:shop": "node tests/e2e/shop.e2e.mjs",
    "test:contrast": "node tests/e2e/home-contrast.e2e.mjs",
    "test:catalog": "node tests/e2e/catalog.e2e.mjs",
    "test:load": "node tests/load/reserve.load.mjs"
  },
  "keywords": [
    "faseela",
    "olive-tree",
    "agriculture",
    "fractional-ownership",
    "syria",
    "olive-oil",
    "evoo",
    "capacitor",
    "ios",
    "android"
  ],
  "author": "Faseela Agritech",
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@fontsource-variable/cairo": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "esbuild": "0.28.2",
    "lucide": "1.49.0",
    "playwright": "1.64.1",
    "tailwindcss": "3.4.19"
  }
}